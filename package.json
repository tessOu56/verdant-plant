{
  "name": "verdant-platform",
  "private": true,
  "version": "2.0.0",
  "description": "Explore Design living lab：動態編排控制台 + FE 深度站。UI 消費 @is_tess/*。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "dev:all": "node scripts/dev.mjs",
    "demo:atelier": "vite --open /atelier.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:dist-app": "node scripts/prepare-dist-app.mjs",
    "build:app": "npm run build && npm run prepare:dist-app && npx cap sync android",
    "build:app:ios": "npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@is_tess/components": "^0.1.2",
    "@is_tess/tokens": "^0.1.1",
    "@tanstack/react-query": "^5.51.0",
    "@types/three": "^0.185.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^2.0.5"
  }
}
